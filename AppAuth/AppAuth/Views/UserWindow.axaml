<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AppAuth.Views.UserWindow"
        Width="400"
        Height="250"
        Title="Пользователь">

    <StackPanel Margin="20" Spacing="15">

        <TextBlock Text="Личный кабинет"
                   FontSize="24"/>

        <TextBlock Name="UserInfoText"
                   FontSize="16"/>

        <Button Content="Выйти из системы"
                Click="OnLogoutClick"/>

    </StackPanel>
</Window>