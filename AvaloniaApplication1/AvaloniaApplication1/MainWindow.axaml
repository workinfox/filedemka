<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaApplication1.MainWindow"
        Title="Влидация данных">
    <Grid RowDefinitions="*,*" ColumnDefinitions="*,*" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Margin="5" Click="GetDataFromAPI">Получить данные</Button>
        <TextBlock Grid.Column="1" Margin="5" Name="email">email</TextBlock>
        <Button Grid.Row="1" Margin="5" Click="SendResultTest">Отправить результаты теста</Button>
        <TextBlock Grid.Row="1" Grid.Column="1" Margin="5" Name="Result">Резы</TextBlock>
        
    </Grid>
</Window>